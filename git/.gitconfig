[user]
	email = justinvalentino88@gmail.com
	name = nittsuj
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[core]
	editor = nvim
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rerere]
	enabled = true
[alias]
	st = status -sb
	co = checkout
	sw = switch
	lg = log --oneline --graph --decorate -20
	amend = commit --amend --no-edit
	undo = reset --soft HEAD~1
